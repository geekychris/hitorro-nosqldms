<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hitorro</groupId>
        <artifactId>hitorro-nosqldms-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>hitorro-nosqldms-core</artifactId>
    <name>Hitorro NoSQL DMS (core, framework-neutral)</name>
    <description>
        Framework-neutral core of the NoSQL-backed document management
        system: types, KV-storage abstractions + in-memory impls, Lucene
        index, DocumentService. No RDBMS anywhere in the chain — content
        is content-addressed by sha256, metadata lives in KV keyspaces,
        search runs off Lucene. Only depends on Jackson + Lucene. No
        Spring. Consumers wire it up via DmsContext (standalone),
        Spring Boot (hitorro-nosqldms-spring-boot), or their own DI container.
    </description>

    <dependencies>
        <!-- JVS type system: Type, JsonTypeSystem, JVS, Propaccess -->
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-jsontypesystem</artifactId>
            <version>3.0.1</version>
            <exclusions>
                <!-- Skip heavy NLP + Groovy — we're using JVS as a plain type system, not for enrichment. -->
                <exclusion><groupId>org.apache.opennlp</groupId><artifactId>opennlp-tools</artifactId></exclusion>
                <exclusion><groupId>org.apache.opennlp</groupId><artifactId>opennlp-dl</artifactId></exclusion>
                <exclusion><groupId>ai.djl.huggingface</groupId><artifactId>tokenizers</artifactId></exclusion>
                <exclusion><groupId>net.sf.extjwnl</groupId><artifactId>extjwnl</artifactId></exclusion>
                <exclusion><groupId>net.sf.extjwnl</groupId><artifactId>extjwnl-data-wn31</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Lucene — the index layer. Optional at compile so callers
             that only want KV can skip it, but bundled by default. -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
            <version>${lucene.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>
</project>
