<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hitorro</groupId>
        <artifactId>hitorro-nosqldms-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>hitorro-nosqldms-spring-boot</artifactId>
    <name>Hitorro NoSQL DMS (Spring Boot runtime)</name>
    <description>
        Spring Boot 4 runtime — wires the framework-neutral core into an
        HTTP service. REST endpoints for documents, versions, renditions,
        folders, references, ACLs, tags, search. Serves the React UI
        bundled from hitorro-nosqldms-web.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-nosqldms-core</artifactId>
            <version>0.1.0</version>
            <exclusions>
                <!-- HiTorro libraries bring reload4j; Boot uses Logback. -->
                <exclusion><groupId>org.slf4j</groupId><artifactId>slf4j-reload4j</artifactId></exclusion>
                <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
            </exclusions>
        </dependency>
        <!-- hitorro-core's com.hitorro.util.log.Logger calls the log4j 1 API;
             route it to SLF4J now that reload4j is excluded. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>log4j-over-slf4j</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 split test support: MockMvc and TestRestTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- TestRestTemplate is built from RestTemplateBuilder (spring-boot-restclient) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.hitorro.dms.spring.DmsApplication</mainClass>
                    <classifier>app</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
